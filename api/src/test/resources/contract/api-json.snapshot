GET /api/condominios/{}/achados
  path: UUID
  query competencia?: string
  returns: [{
    alvo: string
    competencia: string
    condicaoPresente: boolean
    criadoEm: Instant
    descricao: string
    estado: enum[ABERTO, NAO_SE_APLICA_MAIS, JUSTIFICADO, RESOLVIDO, FALSO_POSITIVO]
    estadoEm: Instant
    estadoMotivo: string
    evidencias: [{
      arquivoId: UUID
      linhaPoId: UUID
      ordem: integer
      pagina: integer
      referencia: string
      sha256: string
    }]
    historico: [{
      condicaoPresente: boolean
      em: Instant
      estadoAnterior: enum[ABERTO, NAO_SE_APLICA_MAIS, JUSTIFICADO, RESOLVIDO, FALSO_POSITIVO]
      estadoNovo: enum[ABERTO, NAO_SE_APLICA_MAIS, JUSTIFICADO, RESOLVIDO, FALSO_POSITIVO]
      motivo: string
      usuario: string
    }]
    id: UUID
    regra: string
    severidade: enum[INFORMATIVO, ATENCAO, CRITICO]
    versaoRegra: string
  }]

GET /api/condominios/{}/arquivos
