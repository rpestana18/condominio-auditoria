DELETE /api/condominiums/{}/budgets/{}/extension
  path: UUID
  path: UUID
  returns: {
    budget: {
      confirmedAt: Instant
      confirmedBy: string
      extension: {
        at: Instant
        by: string
        from: string
        justification: string
        until: string
      }
      fileId: UUID
      fileName: string
      fiscalYearEnd: string
      fiscalYearStart: string
      id: UUID
      monthlyPlanned: number
      printedFiscalYear: string
      printedTotal: number
      readAt: Instant
      sha256: string
      status: enum[READ, READ_WITH_DISCREPANCY, CONFIRMED, SUPERSEDED]
      title: string
      version: integer
    }
    budgetedColumn: string
    checks: [{
      classification: enum[OK, ROUNDING, DISCREPANCY, REPEATED_CODE]
      code: string
      description: string
      detail: string
      explanation: string
      ok: boolean
    }]
    confirmation: {
      approvalDate: LocalDate
      discrepancyAcknowledged: boolean
      discrepancyJustification: string
      minutesFileId: UUID
      withoutMinutes: boolean
    }
    findings: [{
      description: string
      id: UUID
      referenceMonth: string
      rule: string
      ruleVersion: string
      severity: string
      status: string
    }]
    funds: [{
      budgeted: number
      description: string
      effectiveCode: string
      fund: string
      fundId: UUID
      lineId: UUID
    }]
    lines: [{
      account: string
      accountText: string
      budgeted: number
      description: string
      effectiveCode: string
      fileId: UUID
      fundLine: boolean
      id: UUID
      mark: enum[SEPARATE_APPORTIONMENT, NEGOTIATED_EXEMPTION, NO_AMOUNT, FIXED_AMOUNT_NO_REFERENCE]
      notes: string
      page: integer
      percentageText: string
      position: integer
      previousBudgeted: number
      printedCode: string
      sha256: string
      type: enum[TOTAL, GROUP, LINE]
    }]
    previousBudgetedColumn: string
    printedMonthlyPlanned: number
    repeatedCodes: [{
      lines: [{
        description: string
        effectiveCode: string
        lineId: UUID
        position: integer
      }]
      printedCode: string
      resolved: boolean
    }]
    roundingTolerance: number
    supersededFrom: string
    warnings: [{
      code: enum[ROUNDING, DISCREPANCY, REPEATED_CODE, CONFIRMED_WITH_DISCREPANCY, OUTSIDE_FIRST_QUARTER, NO_MINUTES, RULE_NOT_EVALUATED]
      text: string
    }]
  }

DELETE /api/condominiums/{}/reallocations/{}
  path: UUID
  path: UUID
  returns: {
    account: string
    accountName: string
    active: boolean
    amount: number
    budgetId: UUID
    date: LocalDate
    document: string
    fileId: UUID
    id: UUID
    lineCode: string
    lineDescription: string
    lineId: UUID
    memo: string
    page: integer
    position: integer
    reallocatedAt: Instant
    reallocatedBy: string
    sha256: string
    undoneAt: Instant
    undoneBy: string
  }

GET /api/ai/providers
  returns: [{
    code: string
    dimension: integer
    function: enum[ANSWERS, EMBEDDINGS]
    local: boolean
    models: [{
      id: string
      inputPricePerMillionUsd: string
      isDefault: boolean
      name: string
      outputPricePerMillionUsd: string
    }]
    name: string
    requiresKey: boolean
    type: string
  }]

GET /api/categories
  returns: [{
    code: enum[TRIAL_BALANCE, BANK_STATEMENT, PO, CONTRACT, PAYROLL, RECEIPT, MINUTES, BYLAWS, OTHER]
    label: string
  }]

GET /api/condominiums/{}/ai
  path: UUID
  returns: {
    assistant: {
      answers: {
        effectiveMode: enum[API_KEY, EXTERNAL_MCP, LOCAL, OFF]
        keyRegistered: boolean
        keySuffix: string
        mode: enum[API_KEY, EXTERNAL_MCP, LOCAL, OFF]
        model: string
        provider: string
      }
      embeddings: {
        mode: enum[API_KEY, EXTERNAL_MCP, LOCAL, OFF]
        model: string
        provider: string
      }
    }
    generalMode: enum[API_KEY, EXTERNAL_MCP, LOCAL, OFF]
    updatedAt: Instant
    updatedBy: string
  }

GET /api/condominiums/{}/budget-items
  path: UUID
  returns: [{
    createdAt: Instant
    createdBy: string
    group: string
    id: UUID
    name: string
    sourceLineId: UUID
  }]

GET /api/condominiums/{}/budget-vs-actual
  path: UUID
  query period: string
  query budget?: UUID
  query fund?: UUID
  returns: {
    adjustments: {
      accounts: [{
        account: string
        amount: number
        detail: string
        entries: integer
        name: string
      }]
      entries: integer
      total: number
    }
    budget: {
      fileId: UUID
      fileName: string
      fiscalYearEnd: string
      fiscalYearStart: string
      id: UUID
      sha256: string
      status: enum[READ, READ_WITH_DISCREPANCY, CONFIRMED, SUPERSEDED]
      version: integer
    }
    calculationVersion: string
    cashFlowCheck: {
      actualExpense: number
      adjustments: number
      entries: integer
      fundDebits: number
      matches: boolean
      transfers: number
    }
    funds: [{
      collected: number
      credits: number
      debits: number
      difference: number
      execution: number
      fund: string
      fundId: UUID
      lineCode: string
      lineId: UUID
      planned: number
      status: enum[COMPARED, NOT_PLANNED_IN_BUDGET, LINE_WITHOUT_FUND, REPROCESS_CASH_FLOW]
    }]
    groups: [{
      actual: number
      code: string
      description: string
      difference: number
      execution: number
      lineId: UUID
      lines: [{
        account: string
        actual: number
        cashFlowAccounts: [string]
        code: string
        description: string
        difference: number
        entries: integer
        execution: number
        lineId: UUID
        mark: enum[SEPARATE_APPORTIONMENT, NEGOTIATED_EXEMPTION, NO_AMOUNT, FIXED_AMOUNT_NO_REFERENCE]
        notes: string
        page: integer
        planned: number
      }]
      planned: number
    }]
    mapping: {
      accounts: integer
      confirmed: integer
      withoutConfirmedMapping: integer
    }
    message: string
    months: [{
      aboveLimit: boolean
      actualExpense: number
      cashFlows: [{
        fileId: UUID
        name: string
        periodEnd: LocalDate
        periodStart: LocalDate
        sha256: string
        uploadedAt: Instant
        uploadedBy: string
      }]
      extended: boolean
      month: string
      overrun: number
      overrunPercentage: number
      planned: number
      status: enum[WITH_CASH_FLOW, NO_CASH_FLOW, TWO_CASH_FLOWS]
    }]
    monthsWithTwoCashFlows: [string]
    monthsWithoutCashFlow: [string]
    period: string
    provisional: boolean
    rule20: {
      aboveLimit: boolean
      limit: number
      limitPercentage: number
      lines: [{
        code: string
        description: string
        lineId: UUID
        overrun: number
      }]
      linesAbove: integer
      maxScenario: number
      maxScenarioPercentage: number
      monthlyPlanned: number
      overrun: number
      percentage: number
      provisional: boolean
      rule: string
      ruleVersion: string
      toReallocate: number
      withoutBudgetLine: number
    }
    status: enum[CALCULATED, NO_BUDGET, BUDGET_NOT_CONFIRMED, NO_OPERATING_FUND, NO_CASH_FLOW, TWO_CASH_FLOWS]
    summedMonths: [string]
    toReallocate: {
      accounts: [{
        account: string
        amount: number
        detail: string
        entries: integer
        name: string
      }]
      entries: integer
      total: number
    }
    totals: {
      actualExpense: number
      difference: number
      execution: number
      fiscalYearPlanned: number
      inLines: number
      monthlyPlanned: number
      planned: number
    }
    warnings: [{
      code: string
      text: string
    }]
    withoutBudgetLine: {
      accounts: [{
        account: string
        amount: number
        detail: string
        entries: integer
        name: string
      }]
      entries: integer
      total: number
    }
  }

GET /api/condominiums/{}/budget-vs-actual/evidence
  path: UUID
