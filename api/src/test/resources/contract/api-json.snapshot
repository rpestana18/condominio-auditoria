GET /api/condominiums/{}/budgets/{}/account-mappings
  path: UUID
  path: UUID
  query filter?: enum[ALL, PENDING, SUGGESTED, CONFIRMED, REJECTED, UNMAPPED, SAME_AS_PREVIOUS_VERSION]
  returns: {
    accounts: [{
      account: string
      debits: number
      ledgerEntries: integer
      name: string
      reason: string
      sameAsPreviousVersion: boolean
      source: enum[PREVIOUS_VERSION, SPREADSHEET, NAME, ADMIN]
      status: enum[SUGGESTED, CONFIRMED, REJECTED]
      target: {
        code: string
        description: string
        detail: string
        lineId: UUID
        text: string
        type: enum[BUDGET_LINE, ADJUSTMENT, TO_REALLOCATE, TRANSFER]
      }
      updatedAt: Instant
      updatedBy: string
    }]
    budgetId: UUID
    summary: {
      accounts: integer
      confirmed: integer
      rejected: integer
      suggested: integer
      withoutMapping: integer
    }
    version: integer
  }

