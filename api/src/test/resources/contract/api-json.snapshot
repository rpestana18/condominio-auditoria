GET /api/condominiums/{}/budgets/{}/line-review
  path: UUID
  path: UUID
  returns: {
    budgetId: UUID
    budgetStatus: enum[READ, READ_WITH_DISCREPANCY, CONFIRMED, SUPERSEDED]
    checkVersion: string
    lines: [{
      account: string
      budgeted: number
      code: string
      description: string
      descriptionPrevails: boolean
      funds: boolean
      groupAccount: boolean
      groupCode: string
      groupDescription: string
      lineId: UUID
      mark: enum[SEPARATE_APPORTIONMENT, NEGOTIATED_EXEMPTION, NO_AMOUNT, FIXED_AMOUNT_NO_REFERENCE]
      notes: string
      origin: {
        averageAmount: number
        averageFrom: string
        averageTo: string
        baseAmount: number
        changedAt: Instant
        changedBy: string
        fileId: UUID
        fileName: string
        finalAmount: number
        indexForecast: boolean
        indexName: string
        indexNote: string
        indexRate: number
        method: enum[AVERAGE_TIMES_INDEX, EQUAL_TO_AVERAGE, TYPED, NO_AVERAGE]
        methodLabel: string
        reason: string
        sha256: string
        sheet: string
        sheetRow: integer
        source: enum[SHEET, ADMIN]
        sourceAccounts: [string]
      }
      page: integer
      percentageText: string
      position: integer
      previousBudgeted: number
      printedCode: string
