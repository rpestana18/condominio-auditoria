      valores: [{
        alvo: string
        exercicioId: string
        linhas: [{
          alvo: string
          codigo: string
          descricao: string
          linhaId: UUID
        }]
        previsto: number
        previstoMes: number
        realizado: number
        variacaoPrevistoMes: {
          novaNoExercicio: boolean
          percentual: number
          valor: number
        }
        variacaoRealizado: {
          novaNoExercicio: boolean
          percentual: number
          valor: number
        }
      }]
