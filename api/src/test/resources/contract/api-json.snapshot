      status: enum[AUTOMATIC, SUGGESTED, CONFIRMED, REJECTED]
      target: {
        code: string
        description: string
        detail: string
        lineId: UUID
        text: string
        type: enum[BUDGET_LINE, ADJUSTMENT, TO_REALLOCATE, TRANSFER, WITHOUT_LINE]
      }
      updatedAt: Instant
      updatedBy: string
    }]
    automaticBySource: {
      admin: integer
      budgetSheet: integer
      name: integer
      previousVersion: integer
      spreadsheet: integer
    }
    budgetId: UUID
    sheet: {
      fileName: string
      lines: integer
      loadedAt: Instant
      loadedBy: string
      sha256: string
    }
    summary: {
      accounts: integer
      automatic: integer
      confirmed: integer
      lowConfidence: integer
      rejected: integer
      withoutMapping: integer
    }
    version: integer
  }

