DELETE /api/condominios/{}/previsoes/{}/prorrogacao
  path: UUID
  path: UUID
  returns: {
    achados: [{
      competencia: string
      descricao: string
      estado: string
      id: UUID
      regra: string
      severidade: string
      versaoRegra: string
    }]
    avisos: [{
      codigo: enum[ARREDONDAMENTO, DIVERGENCIA, CODIGO_REPETIDO, CONFIRMADA_COM_DIVERGENCIA, FORA_PRIMEIRO_TRIMESTRE, SEM_ATA, REGRA_NAO_AVALIADA]
      texto: string
    }]
    codigosRepetidos: [{
      codigoImpresso: string
      linhas: [{
        codigoEfetivo: string
        descricao: string
        linhaId: UUID
        ordem: integer
      }]
      resolvido: boolean
    }]
    colunaOrcado: string
    colunaOrcadoAnterior: string
    conferencias: [{
      classificacao: enum[OK, ARREDONDAMENTO, DIVERGENCIA, CODIGO_REPETIDO]
      codigo: string
      descricao: string
      detalhe: string
      explicacao: string
      ok: boolean
    }]
    confirmacao: {
      ataArquivoId: UUID
      cienteDivergencia: boolean
      dataAprovacao: LocalDate
      justificativaDivergencia: string
      semAta: boolean
    }
    fundos: [{
      codigoEfetivo: string
      descricao: string
      fundo: string
      fundoId: UUID
      linhaId: UUID
      orcado: number
    }]
    linhas: [{
      arquivoId: UUID
      codigoEfetivo: string
      codigoImpresso: string
      conta: string
      contaTexto: string
      descricao: string
      id: UUID
      linhaDeFundo: boolean
      marca: enum[RATEIO_A_PARTE, NEGOCIADA_ISENCAO, SEM_VALOR, VALOR_FIXO_SEM_REFERENCIA]
      observacoes: string
      orcado: number
      orcadoAnterior: number
      ordem: integer
      pagina: integer
      percentualTexto: string
      sha256: string
      tipo: enum[TOTAL, GRUPO, LINHA]
    }]
    previsao: {
      arquivoId: UUID
      arquivoNome: string
      confirmadaEm: Instant
      confirmadaPor: string
      estado: enum[LIDA, LIDA_COM_DIVERGENCIA, CONFIRMADA, SUBSTITUIDA]
      exercicioFim: string
      exercicioImpresso: string
      exercicioInicio: string
      id: UUID
      lidaEm: Instant
      previstoMes: number
      prorrogacao: {
        ate: string
        de: string
        em: Instant
        justificativa: string
        por: string
      }
      sha256: string
      titulo: string
      totalImpresso: number
      versao: integer
    }
    previstoMesImpresso: number
    substituidaDesde: string
    toleranciaArredondamento: number
  }

DELETE /api/condominios/{}/realocacoes/{}
  path: UUID
  path: UUID
