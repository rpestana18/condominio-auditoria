GET /api/condominiums/{}/budgets/{}/account-mappings
  path: UUID
  path: UUID
  query filter?: enum[ALL, EXCEPTIONS, AUTOMATIC, LOW_CONFIDENCE, PENDING, SUGGESTED, CONFIRMED, REJECTED, UNMAPPED, SAME_AS_PREVIOUS_VERSION]
