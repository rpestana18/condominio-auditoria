{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://condominio-auditoria/contracts/mensagens/v2/resultado-processamento.schema.json",
  "title": "ResultadoProcessamento v2",
  "description": "rag → backend (fila backend.resultados). INICIADO quando a leitura começa; CONCLUIDO com os dados extraídos; FALHOU com o motivo. Valores em dinheiro são texto com duas casas (\"1234.56\") para nunca passar por ponto flutuante. v2 (ADR 0004, Decisão 2): igual à v1, mais o bloco previsaoOrcamentaria (PO lida) e a marca recebimentoCota no enriquecimento do lançamento. A v1 não é mais aceita.",
  "type": "object",
  "required": [
    "versao",
    "processamentoId",
    "arquivoId",
    "condominioId",
    "situacao"
  ],
  "additionalProperties": false,
  "properties": {
    "versao": {
      "const": 2
    },
    "processamentoId": {
      "type": "string",
      "format": "uuid"
    },
    "arquivoId": {
      "type": "string",
      "format": "uuid"
    },
    "condominioId": {
      "type": "string",
      "format": "uuid"
    },
    "situacao": {
      "enum": [
        "INICIADO",
        "CONCLUIDO",
        "FALHOU"
      ]
    },
    "motivo": {
      "type": [
        "string",
        "null"
      ],
      "description": "Só em FALHOU: explicação legível"
    },
    "interpretador": {
      "type": [
        "string",
        "null"
      ],
      "description": "Leitor de layout usado (ex.: fluxo-caixa-protest). Nulo quando o layout ainda não é reconhecido."
    },
    "paginas": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "fluxoDeCaixa": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/fluxoDeCaixa"
        }
      ]
    },
    "previsaoOrcamentaria": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/previsaoOrcamentaria"
        }
      ],
      "description": "PO lida. Nulo quando o arquivo não é PO. O hash e o arquivo de origem não vão aqui: o backend já os tem no registro do arquivo."
    },
    "conferencias": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/conferencia"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "situacao": {
            "const": "FALHOU"
          }
        }
      },
      "then": {
        "required": [
          "motivo"
        ]
      }
    }
  ],
  "$defs": {
    "dinheiro": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "data": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "textoOpcional": {
      "type": [
        "string",
        "null"
      ]
    },
    "conferencia": {
      "type": "object",
      "required": [
        "codigo",
        "descricao",
        "ok",
        "detalhe"
      ],
      "additionalProperties": false,
      "properties": {
        "codigo": {
          "type": "string"
        },
        "descricao": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "detalhe": {
          "type": "string"
        }
      }
    },
    "posicao": {
      "type": "object",
      "required": [
        "fundo",
        "saldoAnterior",
        "creditos",
        "debitos",
        "saldoAtual"
      ],
      "additionalProperties": false,
      "properties": {
        "fundo": {
          "type": "string"
        },
        "saldoAnterior": {
          "$ref": "#/$defs/dinheiro"
        },
        "creditos": {
          "$ref": "#/$defs/dinheiro"
        },
        "debitos": {
          "$ref": "#/$defs/dinheiro"
        },
        "saldoAtual": {
          "$ref": "#/$defs/dinheiro"
        }
      }
    },
    "lancamento": {
      "type": "object",
      "required": [
        "pagina",
        "ordem",
        "data",
        "historico",
        "credito",
        "debito",
        "saldo",
        "enriquecimento"
      ],
      "additionalProperties": false,
      "properties": {
        "pagina": {
          "type": "integer",
          "minimum": 1
        },
        "ordem": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "contaCodigo": {
          "$ref": "#/$defs/textoOpcional"
        },
        "contaNome": {
          "$ref": "#/$defs/textoOpcional"
        },
        "documento": {
          "$ref": "#/$defs/textoOpcional"
        },
        "historico": {
          "type": "string"
        },
        "credito": {
          "$ref": "#/$defs/dinheiro"
        },
        "debito": {
          "$ref": "#/$defs/dinheiro"
        },
        "saldo": {
          "$ref": "#/$defs/dinheiro"
        },
        "enriquecimento": {
          "type": "object",
          "required": [
            "transferenciaEntreFundos",
            "recebimentoCota"
          ],
          "additionalProperties": false,
          "properties": {
            "notaFiscal": {
              "$ref": "#/$defs/textoOpcional"
            },
            "fornecedor": {
              "$ref": "#/$defs/textoOpcional"
            },
            "meioPagamento": {
              "$ref": "#/$defs/textoOpcional"
            },
            "transferenciaEntreFundos": {
              "type": "boolean"
            },
            "recebimentoCota": {
              "type": "boolean",
              "description": "Verdadeiro para o crédito \"RECIBOS ACUMULADOS\" do layout Protest (recebimento de cota). Usado na arrecadação dos fundos de reserva e de obras (ADR 0004, Decisão 7)."
            }
          }
        }
      }
    },
    "secao": {
      "type": "object",
      "required": [
        "fundo",
        "saldoAnterior",
        "lancamentos",
        "totalCreditosInformado",
        "totalDebitosInformado"
      ],
      "additionalProperties": false,
      "properties": {
        "fundo": {
          "type": "string"
        },
        "saldoAnterior": {
          "$ref": "#/$defs/dinheiro"
        },
        "lancamentos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lancamento"
          }
        },
        "totalCreditosInformado": {
          "$ref": "#/$defs/dinheiro"
        },
        "totalDebitosInformado": {
          "$ref": "#/$defs/dinheiro"
        }
      }
    },
    "fluxoDeCaixa": {
      "type": "object",
      "required": [
        "periodoInicio",
        "periodoFim",
        "secoes",
        "posicaoFinanceira"
      ],
      "additionalProperties": false,
      "properties": {
        "empreendimento": {
          "$ref": "#/$defs/textoOpcional"
        },
        "periodoInicio": {
          "$ref": "#/$defs/data"
        },
        "periodoFim": {
          "$ref": "#/$defs/data"
        },
        "secoes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/secao"
          }
        },
        "posicaoFinanceira": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/posicao"
          }
        },
        "totalPosicao": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/posicao"
            }
          ]
        }
      }
    },
    "linhaPo": {
      "type": "object",
      "required": [
        "ordem",
        "pagina",
        "tipo",
        "codigoImpresso",
        "conta",
        "marca",
        "descricao",
        "orcadoAnterior",
        "orcado",
        "percentualTexto",
        "observacoes"
      ],
      "additionalProperties": false,
      "properties": {
        "ordem": {
          "type": "integer",
          "minimum": 1,
          "description": "Ordem de leitura no documento. Distingue linhas com o mesmo código impresso."
        },
        "pagina": {
          "type": "integer",
          "minimum": 1
        },
        "tipo": {
          "enum": [
            "TOTAL",
            "GRUPO",
            "LINHA"
          ],
          "description": "TOTAL (código 1), GRUPO (dois níveis, ex.: 1.3) ou LINHA (três níveis, ex.: 1.3.20)"
        },
        "codigoImpresso": {
          "type": "string",
          "minLength": 1,
          "description": "Código como impresso; pode se repetir (ex.: 1.3.2)"
        },
        "conta": {
          "$ref": "#/$defs/textoOpcional",
          "description": "Conta da PO como impressa (ex.: \"1682 - Sindicatura Profissional\"). Nulo quando a coluna não traz código numérico."
        },
        "contaTexto": {
          "$ref": "#/$defs/textoOpcional",
          "description": "Texto da coluna de conta quando não é código nem marca (ex.: \"Débito em receitas eventuais\", \"Fundo de Reserva\", \"Subtotal (soma linhas 5 a 18)\"). Nunca vira conta. Opcional; nulo quando não há texto desse tipo."
        },
        "marca": {
          "enum": [
            null,
            "RATEIO_A_PARTE",
            "NEGOCIADA_ISENCAO",
            "SEM_VALOR",
            "VALOR_FIXO_SEM_REFERENCIA"
          ],
          "description": "Marca lida na coluna de conta (ou \"Rateio à parte\" nas Observações). Nulo quando não há marca."
        },
        "descricao": {
          "type": "string"
        },
        "orcadoAnterior": {
          "$ref": "#/$defs/dinheiro"
        },
        "orcado": {
          "$ref": "#/$defs/dinheiro"
        },
        "percentualTexto": {
          "$ref": "#/$defs/textoOpcional",
          "description": "Coluna \"%\" como texto lido; não entra em cálculo"
        },
        "observacoes": {
          "$ref": "#/$defs/textoOpcional",
          "description": "Observações como texto lido; não entram em cálculo"
        }
      }
    },
    "previsaoOrcamentaria": {
      "type": "object",
      "required": [
        "titulo",
        "exercicioImpresso",
        "colunasOrcado",
        "linhas"
      ],
      "additionalProperties": false,
      "properties": {
        "titulo": {
          "type": "string"
        },
        "exercicioImpresso": {
          "type": "string",
          "description": "Exercício como impresso (ex.: \"2026 / 2027\")"
        },
        "colunasOrcado": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Rótulos impressos das colunas de orçado, na ordem [orcadoAnterior, orcado] (ex.: [\"2025/2026\", \"2026/2027\"])"
        },
        "linhas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/linhaPo"
          }
        }
      }
    }
  }
}