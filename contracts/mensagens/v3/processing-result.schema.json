{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://condominio-auditoria/contracts/mensagens/v3/processing-result.schema.json",
  "title": "ProcessingResult v3",
  "description": "v3 (ADR 0006, fase 2): igual à versão anterior, com nomes e códigos em inglês. rag → api (fila api.processing-results). STARTED quando a leitura começa; COMPLETED com os dados extraídos; FAILED com o motivo. Valores em dinheiro são texto com duas casas (\"1234.56\") para nunca passar por ponto flutuante. v2 (ADR 0004, Decisão 2): igual à v1, mais o bloco budget (PO lida) e a marca condoFeeReceipt no enriquecimento do lançamento. A v1 não é mais aceita.",
  "type": "object",
  "required": ["version", "processingId", "fileId", "condominiumId", "status"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 3},
    "processingId": {"type": "string", "format": "uuid"},
    "fileId": {"type": "string", "format": "uuid"},
    "condominiumId": {"type": "string", "format": "uuid"},
    "status": {"enum": ["STARTED", "COMPLETED", "FAILED"]},
    "reason": {"type": ["string", "null"], "description": "Só em FAILED: explicação legível"},
    "parser": {
      "type": ["string", "null"],
      "description": "Leitor de layout usado (ex.: fluxo-caixa-protest). Nulo quando o layout ainda não é reconhecido."
    },
    "pages": {"type": ["integer", "null"], "minimum": 0},
    "cashFlow": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/cashFlow"}]},
    "budget": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/budget"}],
      "description": "PO lida. Nulo quando o arquivo não é PO. O hash e o arquivo de origem não vão aqui: o backend já os tem no registro do arquivo."
    },
    "totalsChecks": {"type": ["array", "null"], "items": {"$ref": "#/$defs/totalsCheck"}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "FAILED"}}}, "then": {"required": ["reason"]}}],
  "$defs": {
    "money": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "optionalText": {"type": ["string", "null"]},
    "totalsCheck": {
      "type": "object",
      "required": ["code", "description", "ok", "detail"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "description": {"type": "string"},
        "ok": {"type": "boolean"},
        "detail": {"type": "string"}
      }
    },
    "position": {
      "type": "object",
      "required": ["fund", "openingBalance", "credits", "debits", "closingBalance"],
      "additionalProperties": false,
      "properties": {
        "fund": {"type": "string"},
        "openingBalance": {"$ref": "#/$defs/money"},
        "credits": {"$ref": "#/$defs/money"},
        "debits": {"$ref": "#/$defs/money"},
        "closingBalance": {"$ref": "#/$defs/money"}
      }
    },
    "ledgerEntry": {
      "type": "object",
      "required": ["page", "sequence", "date", "memo", "credit", "debit", "balance", "enrichment"],
      "additionalProperties": false,
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "date": {"$ref": "#/$defs/date"},
        "accountCode": {"$ref": "#/$defs/optionalText"},
        "accountName": {"$ref": "#/$defs/optionalText"},
        "document": {"$ref": "#/$defs/optionalText"},
        "memo": {"type": "string"},
        "credit": {"$ref": "#/$defs/money"},
        "debit": {"$ref": "#/$defs/money"},
        "balance": {"$ref": "#/$defs/money"},
        "enrichment": {
          "type": "object",
          "required": ["interFundTransfer", "condoFeeReceipt"],
          "additionalProperties": false,
          "properties": {
            "invoiceNumber": {"$ref": "#/$defs/optionalText"},
            "supplier": {"$ref": "#/$defs/optionalText"},
            "paymentMethod": {"$ref": "#/$defs/optionalText"},
            "interFundTransfer": {"type": "boolean"},
            "condoFeeReceipt": {
              "type": "boolean",
              "description": "Verdadeiro para o crédito \"RECIBOS ACUMULADOS\" do layout Protest (recebimento de cota). Usado na arrecadação dos fundos de reserva e de obras (ADR 0004, Decisão 7)."
            }
          }
        }
      }
    },
    "fundSection": {
      "type": "object",
      "required": ["fund", "openingBalance", "entries", "reportedCreditTotal", "reportedDebitTotal"],
      "additionalProperties": false,
      "properties": {
        "fund": {"type": "string"},
        "openingBalance": {"$ref": "#/$defs/money"},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/ledgerEntry"}},
        "reportedCreditTotal": {"$ref": "#/$defs/money"},
        "reportedDebitTotal": {"$ref": "#/$defs/money"}
      }
    },
    "cashFlow": {
      "type": "object",
      "required": ["periodStart", "periodEnd", "sections", "financialPosition"],
      "additionalProperties": false,
      "properties": {
        "property": {"$ref": "#/$defs/optionalText"},
        "periodStart": {"$ref": "#/$defs/date"},
        "periodEnd": {"$ref": "#/$defs/date"},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/fundSection"}},
        "financialPosition": {"type": "array", "items": {"$ref": "#/$defs/position"}},
        "positionTotal": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/position"}]}
      }
    },
    "budgetLine": {
      "type": "object",
      "required": [
        "sequence",
        "page",
        "type",
        "printedCode",
        "account",
        "mark",
        "description",
        "previousBudgeted",
        "budgeted",
        "percentageText",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "Ordem de leitura no documento. Distingue linhas com o mesmo código impresso."
        },
        "page": {"type": "integer", "minimum": 1},
        "type": {
          "enum": ["TOTAL", "GROUP", "LINE"],
          "description": "TOTAL (código 1), GROUP (dois níveis, ex.: 1.3) ou LINE (três níveis, ex.: 1.3.20)"
        },
        "printedCode": {
          "type": "string",
          "minLength": 1,
          "description": "Código como impresso; pode se repetir (ex.: 1.3.2)"
        },
        "account": {
          "$ref": "#/$defs/optionalText",
          "description": "Conta da PO como impressa (ex.: \"1682 - Sindicatura Profissional\"). Nulo quando a coluna não traz código numérico."
        },
        "accountText": {
          "$ref": "#/$defs/optionalText",
          "description": "Texto da coluna de conta quando não é código nem marca (ex.: \"Débito em receitas eventuais\", \"Fundo de Reserva\", \"Subtotal (soma linhas 5 a 18)\"). Nunca vira conta. Opcional; nulo quando não há texto desse tipo."
        },
        "mark": {
          "enum": [null, "SEPARATE_APPORTIONMENT", "NEGOTIATED_EXEMPTION", "NO_AMOUNT", "FIXED_AMOUNT_NO_REFERENCE"],
          "description": "Marca lida na coluna de conta (ou \"Rateio à parte\" nas Observações). Nulo quando não há marca."
        },
        "description": {"type": "string"},
        "previousBudgeted": {"$ref": "#/$defs/money"},
        "budgeted": {"$ref": "#/$defs/money"},
        "percentageText": {
          "$ref": "#/$defs/optionalText",
          "description": "Coluna \"%\" como texto lido; não entra em cálculo"
        },
        "notes": {"$ref": "#/$defs/optionalText", "description": "Observações como texto lido; não entram em cálculo"}
      }
    },
    "budget": {
      "type": "object",
      "required": ["title", "printedFiscalYear", "budgetColumns", "lines"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "printedFiscalYear": {"type": "string", "description": "Exercício como impresso (ex.: \"2026 / 2027\")"},
        "budgetColumns": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 2,
          "maxItems": 2,
          "description": "Rótulos impressos das colunas de orçado, na ordem [previousBudgeted, orcado] (ex.: [\"2025/2026\", \"2026/2027\"])"
        },
        "lines": {"type": "array", "items": {"$ref": "#/$defs/budgetLine"}}
      }
    }
  }
}
