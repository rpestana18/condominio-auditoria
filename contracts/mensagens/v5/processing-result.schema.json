{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://condominio-auditoria/contracts/mensagens/v5/processing-result.schema.json",
  "title": "ProcessingResult v5",
  "description": "v5 (ADR 0009, Decisão 8, aprovada pelo usuário em 29/10/2026): igual à v4, mais a lista accounts em budgetLineOrigins: as contas da aba das despesas da planilha de apoio (código, nome, linha e a conta-mãe deduzida pelas somas), que fazem a ponte entre as contas do extrato e as linhas da PO no de-para automático. v4 (ADR 0009, Decisão 3 B): igual à v3, mais o bloco budgetLineOrigins, com a origem de cada linha da PO lida da planilha de apoio (.xlsx, contrato do leitor v2 sem mudança). As outras mensagens da fila (FileReceived, IndexFile, IndexingResult) continuam na v3. v3 (ADR 0006, fase 2): igual à versão anterior, com nomes e códigos em inglês. rag → api (fila api.processing-results). STARTED quando a leitura começa; COMPLETED com os dados extraídos; FAILED com o motivo. Valores em dinheiro são texto com duas casas (\"1234.56\") para nunca passar por ponto flutuante. v2 (ADR 0004, Decisão 2): igual à v1, mais o bloco budget (PO lida) e a marca condoFeeReceipt no enriquecimento do lançamento. A v1 não é mais aceita.",
  "type": "object",
  "required": [
    "version",
    "processingId",
    "fileId",
    "condominiumId",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 5
    },
    "processingId": {
      "type": "string",
      "format": "uuid"
    },
    "fileId": {
      "type": "string",
      "format": "uuid"
    },
    "condominiumId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "STARTED",
        "COMPLETED",
        "FAILED"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Só em FAILED: explicação legível"
    },
    "parser": {
      "type": [
        "string",
        "null"
      ],
      "description": "Leitor de layout usado (ex.: fluxo-caixa-protest). Nulo quando o layout ainda não é reconhecido."
    },
    "pages": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cashFlow": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/cashFlow"
        }
      ]
    },
    "budget": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/budget"
        }
      ],
      "description": "PO lida. Nulo quando o arquivo não é PO. O hash e o arquivo de origem não vão aqui: o backend já os tem no registro do arquivo."
    },
    "budgetLineOrigins": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/budgetLineOrigins"
        }
      ],
      "description": "Origem das linhas da PO lida da planilha de apoio (RF-13.13). Nulo quando o arquivo não é planilha de apoio. A origem só explica: o previsto continua o valor da PO (O4). O api liga cada linha à linha da PO pela ordem das linhas de despesa (grupos 1.1 a 1.8)."
    },
    "totalsChecks": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/totalsCheck"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ],
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "optionalText": {
      "type": [
        "string",
        "null"
      ]
    },
    "totalsCheck": {
      "type": "object",
      "required": [
        "code",
        "description",
        "ok",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "position": {
      "type": "object",
      "required": [
        "fund",
        "openingBalance",
        "credits",
        "debits",
        "closingBalance"
      ],
      "additionalProperties": false,
      "properties": {
        "fund": {
          "type": "string"
        },
        "openingBalance": {
          "$ref": "#/$defs/money"
        },
        "credits": {
          "$ref": "#/$defs/money"
        },
        "debits": {
          "$ref": "#/$defs/money"
        },
        "closingBalance": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "ledgerEntry": {
      "type": "object",
      "required": [
        "page",
        "sequence",
        "date",
        "memo",
        "credit",
        "debit",
        "balance",
        "enrichment"
      ],
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "accountCode": {
          "$ref": "#/$defs/optionalText"
        },
        "accountName": {
          "$ref": "#/$defs/optionalText"
        },
        "document": {
          "$ref": "#/$defs/optionalText"
        },
        "memo": {
          "type": "string"
        },
        "credit": {
          "$ref": "#/$defs/money"
        },
        "debit": {
          "$ref": "#/$defs/money"
        },
        "balance": {
          "$ref": "#/$defs/money"
        },
        "enrichment": {
          "type": "object",
          "required": [
            "interFundTransfer",
            "condoFeeReceipt"
          ],
          "additionalProperties": false,
          "properties": {
            "invoiceNumber": {
              "$ref": "#/$defs/optionalText"
            },
            "supplier": {
              "$ref": "#/$defs/optionalText"
            },
            "paymentMethod": {
              "$ref": "#/$defs/optionalText"
            },
            "interFundTransfer": {
              "type": "boolean"
            },
            "condoFeeReceipt": {
              "type": "boolean",
              "description": "Verdadeiro para o crédito \"RECIBOS ACUMULADOS\" do layout Protest (recebimento de cota). Usado na arrecadação dos fundos de reserva e de obras (ADR 0004, Decisão 7)."
            }
          }
        }
      }
    },
    "fundSection": {
      "type": "object",
      "required": [
        "fund",
        "openingBalance",
        "entries",
        "reportedCreditTotal",
        "reportedDebitTotal"
      ],
      "additionalProperties": false,
      "properties": {
        "fund": {
          "type": "string"
        },
        "openingBalance": {
          "$ref": "#/$defs/money"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ledgerEntry"
          }
        },
        "reportedCreditTotal": {
          "$ref": "#/$defs/money"
        },
        "reportedDebitTotal": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "cashFlow": {
      "type": "object",
      "required": [
        "periodStart",
        "periodEnd",
        "sections",
        "financialPosition"
      ],
      "additionalProperties": false,
      "properties": {
        "property": {
          "$ref": "#/$defs/optionalText"
        },
        "periodStart": {
          "$ref": "#/$defs/date"
        },
        "periodEnd": {
          "$ref": "#/$defs/date"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fundSection"
          }
        },
        "financialPosition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/position"
          }
        },
        "positionTotal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/position"
            }
          ]
        }
      }
    },
    "budgetLine": {
      "type": "object",
      "required": [
        "sequence",
        "page",
        "type",
        "printedCode",
        "account",
        "mark",
        "description",
        "previousBudgeted",
        "budgeted",
        "percentageText",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "Ordem de leitura no documento. Distingue linhas com o mesmo código impresso."
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "TOTAL",
            "GROUP",
            "LINE"
          ],
          "description": "TOTAL (código 1), GROUP (dois níveis, ex.: 1.3) ou LINE (três níveis, ex.: 1.3.20)"
        },
        "printedCode": {
          "type": "string",
          "minLength": 1,
          "description": "Código como impresso; pode se repetir (ex.: 1.3.2)"
        },
        "account": {
          "$ref": "#/$defs/optionalText",
          "description": "Conta da PO como impressa (ex.: \"1682 - Sindicatura Profissional\"). Nulo quando a coluna não traz código numérico."
        },
        "accountText": {
          "$ref": "#/$defs/optionalText",
          "description": "Texto da coluna de conta quando não é código nem marca (ex.: \"Débito em receitas eventuais\", \"Fundo de Reserva\", \"Subtotal (soma linhas 5 a 18)\"). Nunca vira conta. Opcional; nulo quando não há texto desse tipo."
        },
        "mark": {
          "enum": [
            null,
            "SEPARATE_APPORTIONMENT",
            "NEGOTIATED_EXEMPTION",
            "NO_AMOUNT",
            "FIXED_AMOUNT_NO_REFERENCE"
          ],
          "description": "Marca lida na coluna de conta (ou \"Rateio à parte\" nas Observações). Nulo quando não há marca."
        },
        "description": {
          "type": "string"
        },
        "previousBudgeted": {
          "$ref": "#/$defs/money"
        },
        "budgeted": {
          "$ref": "#/$defs/money"
        },
        "percentageText": {
          "$ref": "#/$defs/optionalText",
          "description": "Coluna \"%\" como texto lido; não entra em cálculo"
        },
        "notes": {
          "$ref": "#/$defs/optionalText",
          "description": "Observações como texto lido; não entram em cálculo"
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "title",
        "printedFiscalYear",
        "budgetColumns",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "printedFiscalYear": {
          "type": "string",
          "description": "Exercício como impresso (ex.: \"2026 / 2027\")"
        },
        "budgetColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Rótulos impressos das colunas de orçado, na ordem [previousBudgeted, orcado] (ex.: [\"2025/2026\", \"2026/2027\"])"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/budgetLine"
          }
        }
      }
    },
    "rate": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{1,6}$",
      "description": "Taxa como fração decimal em texto (\"0.0723\" = 7,23%), nunca ponto flutuante"
    },
    "yearMonth": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "budgetLineOrigin": {
      "type": "object",
      "required": [
        "sequence",
        "row",
        "printedCode",
        "account",
        "description",
        "sourceAccounts",
        "averageFrom",
        "averageTo",
        "averageAmount",
        "baseAmount",
        "method",
        "indexName",
        "indexRate",
        "indexForecast",
        "indexNote",
        "finalAmount",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "Ordem da linha de despesa na planilha (grupos 1.1 a 1.8), a mesma ordem das linhas de despesa da PO"
        },
        "row": {
          "type": "integer",
          "minimum": 1,
          "description": "Linha da planilha (aba da PO), para a rastreabilidade"
        },
        "printedCode": {
          "$ref": "#/$defs/optionalText",
          "description": "Item como lido na planilha (uma data quando a planilha converteu o código)"
        },
        "account": {
          "$ref": "#/$defs/optionalText",
          "description": "Coluna de conta como lida (ex.: \"1692 - Vigia e Portaria\")"
        },
        "description": {
          "type": "string"
        },
        "sourceAccounts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Códigos das contas de origem citados na coluna de conta (ex.: [\"1591\", \"1592\"])"
        },
        "averageFrom": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/yearMonth"
            }
          ],
          "description": "Primeiro mês da média; nulo sem média"
        },
        "averageTo": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/yearMonth"
            }
          ],
          "description": "Último mês da média; nulo sem média"
        },
        "averageAmount": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/money"
            }
          ],
          "description": "Média das contas de origem no período (soma das contas), quando a base da linha é essa média"
        },
        "baseAmount": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/money"
            }
          ],
          "description": "Valor de referência da linha na planilha (coluna do realizado ou da média)"
        },
        "method": {
          "enum": [
            "AVERAGE_TIMES_INDEX",
            "EQUAL_TO_AVERAGE",
            "TYPED",
            "NO_AVERAGE"
          ],
          "description": "Deduzido pelos números, tolerância R$ 0,01: final = média × (1 + índice) → AVERAGE_TIMES_INDEX; final = média → EQUAL_TO_AVERAGE; com média e outro valor → TYPED; base que não é a média de nenhuma conta → NO_AVERAGE"
        },
        "indexName": {
          "$ref": "#/$defs/optionalText",
          "description": "Nome do índice como na aba de índices (ex.: \"VIGILANTES RJ\"); só em AVERAGE_TIMES_INDEX"
        },
        "indexRate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rate"
            }
          ],
          "description": "Valor aplicado do índice"
        },
        "indexForecast": {
          "type": "boolean",
          "description": "Verdadeiro quando a aba marca o índice como previsão (ex.: dissídio 6,5%)"
        },
        "indexNote": {
          "$ref": "#/$defs/optionalText",
          "description": "Anotação quando o rótulo não combina com o valor (O4), ex.: \"rótulo IGP-M, valor aplicado 4,44% (igual ao IPCA ACUMULADO)\""
        },
        "finalAmount": {
          "$ref": "#/$defs/money",
          "description": "Valor final da linha na planilha"
        },
        "reason": {
          "$ref": "#/$defs/optionalText",
          "description": "Observação da planilha (motivo), ex.: \"Negociação contratual\""
        }
      }
    },
    "budgetLineOrigins": {
      "type": "object",
      "required": [
        "sheet",
        "expensesSheet",
        "indexSheet",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "sheet": {
          "type": "string",
          "description": "Aba da PO na planilha"
        },
        "expensesSheet": {
          "$ref": "#/$defs/optionalText",
          "description": "Aba das despesas com as médias por conta"
        },
        "indexSheet": {
          "$ref": "#/$defs/optionalText",
          "description": "Aba dos índices"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/budgetLineOrigin"
          }
        },
        "accounts": {
          "type": [
            "array",
            "null"
          ],
          "description": "Contas da aba das despesas, na ordem da aba (RF-13.13, Q54). Nulo ou vazio quando a planilha não tem a aba. Plano de contas da PO (não o do extrato): o api só compara os nomes, nunca o número com o do extrato (RF-00.8).",
          "items": {
            "$ref": "#/$defs/expenseAccount"
          }
        }
      }
    },
    "expenseAccount": {
      "type": "object",
      "required": [
        "code",
        "name",
        "row",
        "parentCode"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^\\d{1,20}$",
          "description": "Código da conta impresso na aba (ex.: 1547)"
        },
        "name": {
          "type": "string",
          "description": "Nome da conta como impresso, sem o código (ex.: Adiantamento Quinzenal)"
        },
        "row": {
          "type": "integer",
          "minimum": 1,
          "description": "Linha da aba"
        },
        "parentCode": {
          "type": [
            "string",
            "null"
          ],
          "description": "Conta-mãe (grupo) deduzida pelas somas: a conta é uma das contas seguidas que somam, mês a mês e ao centavo, o valor da conta-mãe (ex.: 1547 em 1545 Verbas Salariais). Nulo quando não há"
        }
      }
    }
  }
}
